# Секреты: .env в репозиторий не коммитится, .env.example — коммитится.
.env

# Окружение uv пересоздаётся командой `uv sync`.
.venv/

# Кэши и артефакты инструментов.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/
*.egg-info/

# Сгенерированные демонстрационные файлы дублируют исходные assets.
output/

# Экспорт диалога (scripts/export-chat.py) — генерируется заново и содержит
# весь ход работы: внутренние пути, id, переписку. В репозитории ему нечего
# делать; при этом он не секрет (секреты скрипт вычищает), а просто шум.
chat-export.*

# Каталог .vscode намеренно НЕ в gitignore: в нём лежат общие настройки
# проекта (интерпретатор, задачи, отладка) — они одинаковы для всех, кто
# открывает репозиторий. Личные настройки живут в User Settings и сюда
# не попадают.
