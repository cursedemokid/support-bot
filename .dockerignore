# Контекст сборки docker compose build. Заказчик разворачивает без
# реестра — образ собирается прямо на VPS, поэтому от размера и состава
# контекста впрямую зависит время сборки на слабой машине. Dockerfile
# копирует только pyproject.toml, uv.lock, app, config и migrations — ни
# один из них под правила ниже не подпадает (проверено вручную).

# Локальное окружение uv: сотни мегабайт, а в образе зависимости ставятся
# заново в /opt/venv (UV_PROJECT_ENVIRONMENT в Dockerfile) — копия с хоста
# только замедлила бы отправку контекста демону.
.venv/

# История репозитория. Сборке не нужна (Dockerfile не читает git-метаданные),
# а по объёму обычно больше самого рабочего дерева.
.git/

# Worktree параллельных агентов Claude Code — в каждом полная копия app/ из
# своей ветки (см. .gitignore). Самый тяжёлый путь из всех, что мог бы
# случайно уехать в контекст.
.claude/worktrees/

# Дампы scripts/backup.sh (по умолчанию пишет в ./backups, см. сам скрипт).
# Не артефакт сборки, а рантайм-данные: растут день за днём и содержат всю
# схему topactive — telegram-id, username, display_name участников
# (docs/SECURITY-REVIEW.md §6.2).
backups/

# Кэши и артефакты инструментов Python. Пересоздаются заново при каждом
# прогоне линтера или тестов — в образе не нужны ни при каком раскладе.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/
*.egg-info/

# Секреты и данные администраторов. docker-compose.yml монтирует ./config
# поверх каталога в образе — это прячет то, что попало в слой при сборке,
# из контейнера в рантайме, но не из самого образа: слой в нём остаётся.
# .env — токен бота и строка подключения к базе (см. .env.example);
# Dockerfile его и так не копирует, а env_file в docker-compose.yml читает
# файл с хоста напрямую, в обход слоёв образа — исключение из контекста
# ничего не ломает, только закрывает дыру на случай, если COPY когда-нибудь
# расширят. config/settings-changelog.tsv — журнал правок настроек с
# telegram-id администраторов (см. .gitignore). settings.yaml НЕ исключаем:
# без него образ не запустится, а версия в репозитории — обезличенный
# стартовый набор значений.
.env
config/settings-changelog.tsv
